{
  "name": "vizer-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Vizer — PWA de pronostics sportifs NHL/NBA (consomme la branche models-artifacts)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --noEmit",
    "icons": "python3 scripts/gen_icons.py",
    "test": "node scripts/selftest.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
