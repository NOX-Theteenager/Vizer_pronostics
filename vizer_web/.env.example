# Base des prédictions publiées.
#
# Par défaut (variable absente), la PWA lit directement
# raw.githubusercontent.com — ce qui marche partout, y compris en local et sur
# GitHub Pages, mais impose le cache CDN de GitHub et son quota par IP.
#
# Sur Vercel, on la fait pointer sur le proxy Edge du dépôt (api/data), qui sert
# les mêmes fichiers depuis la même origine avec nos propres en-têtes de cache.
# VITE_DATA_BASE=/api/data/predictions

# Dépôt lu par l'écran Admin (runs GitHub Actions, historique des modèles).
# VITE_GITHUB_REPO=NOX-Theteenager/Vizer_pronostics

# Mode démo : sert public/mock/ au lieu des données publiées.
# VITE_USE_MOCK=1
